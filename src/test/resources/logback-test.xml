<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests log to the console only. Without this file a Spring Boot test would use application.yml's
  logging.file.name and write to logs/stock-research-ai.log - the running application's own file - and its
  rollover could overwrite that day's archive of the application's log.
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %-42logger{42} : %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
